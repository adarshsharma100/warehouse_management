generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model gatepass_order {
  gpo_id        Int      @id @unique(map: "gpo_id_UNIQUE") @default(autoincrement())
  gatepass_code String   @db.VarChar(45)
  quantity      Int
  to_party      String   @db.VarChar(45)
  created_at    DateTime @db.DateTime(0)
}

model grn {
  grn_id                     Int              @id @unique(map: "grn_id_UNIQUE") @default(autoincrement())
  grn_batch_code             String?          @db.VarChar(45)
  grn_status                 String           @default("Created") @db.VarChar(45)
  created_on                 DateTime         @default(now())
  grn_desc                   String?          @db.VarChar(45)
  grn_status_id              Int              @default(1)
  grn_status_grnTogrn_status grn_status       @relation(fields: [grn_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_grn_grn_status1")
  purchase_order             purchase_order[]

  @@index([grn_status_id], map: "fk_grn_grn_status1_idx")
}

model inventory_products {
  inventory_product_id Int      @unique @default(autoincrement())
  product_description  String?  @db.VarChar(45)
  price                Int?     @default(0)
  quantity             Int      @default(0)
  products_product_id  Int
  created_at           DateTime @default(now()) @db.DateTime(0)
  products             products @relation(fields: [products_product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_products_products1")

  @@id([inventory_product_id, products_product_id])
  @@index([products_product_id], map: "fk_inventory_products_products1_idx")
}

model products {
  product_id         Int                  @id @unique @default(autoincrement())
  name               String               @db.VarChar(45)
  description        String?              @db.LongText
  product_type       String               @db.VarChar(45)
  products_sku       String?              @unique(map: "products_sku_UNIQUE") @db.VarChar(45)
  Price              Int?                 @default(0)
  inventory_products inventory_products[]
  rfq_products       rfq_products[]
  vendor_products    vendor_products[]
}

model purchase_order {
  po_id                        Int                              @unique(map: "po_id_UNIQUE") @default(autoincrement())
  po_type                      String                           @default("Manual") @db.VarChar(45)
  updated_on                   DateTime?                        @default(now())
  approved_on                  DateTime?                        @db.DateTime(0)
  created_at                   DateTime?                        @default(now())
  from_party                   String                           @db.VarChar(45)
  expiry_date                  DateTime                         @db.DateTime(0)
  expected_delivery            DateTime                         @db.DateTime(0)
  agreement                    String?                          @db.VarChar(45)
  purchase_order_status_pos_id Int                              @default(2)
  vendor_vendor_id             Int
  po_description               String                           @db.VarChar(155)
  po_code                      String                           @db.VarChar(45)
  rfq_id                       Int?
  grn_grn_id                   Int?
  agreement_status             purchase_order_agreement_status?
  grn                          grn?                             @relation(fields: [grn_grn_id], references: [grn_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_order_grn1")
  purchase_order_status        purchase_order_status            @relation(fields: [purchase_order_status_pos_id], references: [pos_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_order_purchase_order_status1")
  rfq                          rfq?                             @relation(fields: [rfq_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_order_rfq1")
  vendor                       vendor                           @relation(fields: [vendor_vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_order_vendor1")
  purchase_order_products      purchase_order_products[]

  @@id([po_id, purchase_order_status_pos_id, vendor_vendor_id])
  @@unique([po_id, purchase_order_status_pos_id])
  @@index([purchase_order_status_pos_id], map: "fk_purchase_order_purchase_order_status1_idx")
  @@index([vendor_vendor_id], map: "fk_purchase_order_vendor1_idx")
  @@index([rfq_id], map: "fk_purchase_order_rfq1_idx")
  @@index([grn_grn_id], map: "fk_purchase_order_grn1_idx")
}

model purchase_order_status {
  pos_id          Int              @id @unique(map: "pos_id_UNIQUE") @default(autoincrement())
  pos_name        String           @db.VarChar(45)
  pos_description String           @db.VarChar(45)
  purchase_order  purchase_order[]
}

model vendor {
  vendor_id       Int               @id @unique(map: "vendor_id_UNIQUE") @default(autoincrement())
  vendor_code     String            @unique(map: "vendor_code_UNIQUE") @db.VarChar(45)
  vendor_email    String            @unique(map: "vendor_email_UNIQUE") @db.VarChar(45)
  vendor_city     String            @db.VarChar(45)
  vendor_contact  String            @db.VarChar(45)
  vendor_gstin    String            @unique(map: "vendor_gstin_UNIQUE") @db.VarChar(45)
  vendor          String            @db.VarChar(45)
  address         String            @db.VarChar(145)
  credit_period   String            @db.VarChar(45)
  lead_time       String            @db.VarChar(45)
  status          Boolean?          @default(true)
  purchase_order  purchase_order[]
  vendor_products vendor_products[]
}

model vendor_products {
  vp_id                   Int                       @unique(map: "vpt_id_UNIQUE") @default(autoincrement())
  unit_price              Int
  vendor_vendor_id        Int
  products_product_id     Int
  enabled                 Int                       @default(1) @db.TinyInt
  priority                Int                       @default(1)
  vendor_sku              String                    @unique(map: "vendor_sku_UNIQUE") @db.VarChar(45)
  products                products                  @relation(fields: [products_product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vendor_products_products1")
  vendor                  vendor                    @relation(fields: [vendor_vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vendor_products_vendor")
  purchase_order_products purchase_order_products[]

  @@id([vp_id, vendor_vendor_id, products_product_id])
  @@index([products_product_id], map: "fk_vendor_products_products1_idx")
  @@index([vendor_vendor_id], map: "fk_vendor_products_vendor_idx")
}

model rfq {
  id              Int              @id @unique(map: "rfc_id_key") @default(autoincrement())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  expected_dod    String           @db.VarChar(65)
  rfq_code        String           @db.VarChar(45)
  rfq_description String           @db.VarChar(155)
  active          Int              @default(1) @db.TinyInt
  purchase_order  purchase_order[]
  rfq_products    rfq_products[]
  rfq_sentto      rfq_sentto[]
}

model session {
  id                 Int       @id @default(autoincrement())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())
  expiresAt          DateTime?
  handle             String    @unique(map: "Session_handle_key")
  hashedSessionToken String?
  antiCSRFToken      String?
  publicData         String?
  privateData        String?
  userId             Int?
  user               user?     @relation(fields: [userId], references: [id], map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_fkey")
}

model token {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  hashedToken String
  type        String
  expiresAt   DateTime
  sentTo      String
  userId      Int
  user        user     @relation(fields: [userId], references: [id], map: "Token_userId_fkey")

  @@unique([hashedToken, type], map: "Token_hashedToken_type_key")
  @@index([userId], map: "Token_userId_fkey")
}

model user {
  id                  Int                   @id @default(autoincrement())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  name                String?
  email               String                @unique(map: "User_email_key")
  hashedPassword      String?
  role                String                @default("USER")
  mutation_admin_mail mutation_admin_mail[]
  notifications_sent  notifications_sent[]
  session             session[]
  token               token[]
}

model rfq_products {
  rfq_products_id     Int      @unique(map: "rfq_products_id_UNIQUE") @default(autoincrement())
  rfq_id              Int
  products_product_id Int
  quantity            Int?
  price_per_unit      Int?
  products            products @relation(fields: [products_product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rfq_products_products1")
  rfq                 rfq      @relation(fields: [rfq_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rfq_products_rfq1")

  @@id([rfq_products_id, rfq_id, products_product_id])
  @@index([products_product_id], map: "fk_rfq_products_products1_idx")
  @@index([rfq_id], map: "fk_rfq_products_rfq1_idx")
}

model purchase_order_products {
  pop_id                                      Int             @unique(map: "pop_id_UNIQUE") @default(autoincrement())
  purchase_order_po_id                        Int
  purchase_order_purchase_order_status_pos_id Int
  purchase_order_vendor_vendor_id             Int
  vendor_products_vp_id                       Int
  vendor_products_vendor_vendor_id            Int
  vendor_products_products_product_id         Int
  quantity                                    Int
  price_per_unit                              Int?
  received_quantity                           Int?
  purchase_order                              purchase_order  @relation(fields: [purchase_order_po_id, purchase_order_purchase_order_status_pos_id, purchase_order_vendor_vendor_id], references: [po_id, purchase_order_status_pos_id, vendor_vendor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_order_products_purchase_order1")
  vendor_products                             vendor_products @relation(fields: [vendor_products_vp_id, vendor_products_vendor_vendor_id, vendor_products_products_product_id], references: [vp_id, vendor_vendor_id, products_product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_order_products_vendor_products1")

  @@id([pop_id, purchase_order_po_id, purchase_order_purchase_order_status_pos_id, purchase_order_vendor_vendor_id, vendor_products_vp_id, vendor_products_vendor_vendor_id, vendor_products_products_product_id, quantity])
  @@index([purchase_order_po_id, purchase_order_purchase_order_status_pos_id, purchase_order_vendor_vendor_id], map: "fk_purchase_order_products_purchase_order1")
  @@index([vendor_products_vp_id, vendor_products_vendor_vendor_id, vendor_products_products_product_id], map: "fk_purchase_order_products_vendor_products1_idx")
}

model mutation_admin_mail {
  id                     Int                 @unique(map: "id_UNIQUE") @default(autoincrement())
  user_id                Int
  mutations_functions_id Int
  mutations_functions    mutations_functions @relation(fields: [mutations_functions_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mutation_admin_mail_mutations_functions1")
  user                   user                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mutation_admin_mail_user1")

  @@id([id, user_id, mutations_functions_id])
  @@index([mutations_functions_id], map: "fk_mutation_admin_mail_mutations_functions1_idx")
  @@index([user_id], map: "fk_mutation_admin_mail_user1_idx")
}

model mutations_functions {
  id                  Int                   @id @unique(map: "id_UNIQUE") @default(autoincrement())
  name                String                @db.VarChar(45)
  email_format        String?               @db.VarChar(255)
  mutation_admin_mail mutation_admin_mail[]
}

model notifications_sent {
  id         Int    @id @unique(map: "id_UNIQUE") @default(autoincrement())
  user_name  String @db.VarChar(45)
  user_email String @db.VarChar(45)
  mutations  String @db.VarChar(45)
  created_at String @db.VarChar(255)
  user_id    Int
  user       user   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifications_sent_user1")

  @@index([user_id], map: "fk_notifications_sent_user1_idx")
}

model rfq_sentto {
  id     Int     @id @default(autoincrement())
  email  String? @db.VarChar(45)
  rfq_id Int
  rfq    rfq     @relation(fields: [rfq_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rfq_sentto_rfq1")

  @@index([rfq_id], map: "fk_rfq_sentto_rfq1_idx")
}

model prefix {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(45)
  prefix String @db.VarChar(45)
}

model grn_status {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(45)
  grn  grn[]
}

enum purchase_order_agreement_status {
  Approved
  Waiting_For_Approval  @map("Waiting For Approval")
}
